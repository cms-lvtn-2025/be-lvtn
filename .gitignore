# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Environment variables
.env
*.env
!*.env.example
env/*.env
!env/*.env.example

# TLS Certificates and Keys (SECURITY)
*.key
*.crt
*.cnf
*.pem

# IDE
.idea/
.vscode/

# Service binaries
src/service/*/academic
src/service/*/council
src/service/*/file
src/service/*/role
src/service/*/thesis
src/service/*/user

# Logs
*.log
logs/

# Don't ignore important config files
!.github/workflows/*.yml
!docker-compose*.yml
!**/docker-compose*.yml
