# ==============================================
# Docker Compose Environment Configuration
# ==============================================
# Copy this file to .env and adjust values for your environment
# cp .env.example .env

# ==============================================
# MySQL Database Configuration
# ==============================================
DB_HOST=mysql
DB_PORT=10001
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=lvtn-db-v4

# ==============================================
# Redis Configuration
# ==============================================
REDIS_HOST=redis
REDIS_PORT=10002
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5
REDIS_READ_TIMEOUT=3
REDIS_WRITE_TIMEOUT=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2

# ==============================================
# MongoDB Configuration
# ==============================================
MONGO_HOST=mongodb
MONGO_PORT=10000
MONGO_USERNAME=your_username
MONGO_PASSWORD=your_password_here
MONGO_DATABASE=thesis_db
MONGO_AUTH_SOURCE=admin
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_CONN_IDLE_TIME=60
MONGO_CONNECT_TIMEOUT=10
MONGO_SERVER_SELECTION_TIMEOUT=10

# ==============================================
# MinIO Object Storage Configuration
# ==============================================
MIN_PORT=10005
MIN_ENDPOINT=minio:9000
MIN_ACCESS_KEY=your_access_key
MIN_SECRET_KEY=your_secret_key_here
MIN_USE_SSL=false
MIN_BUCKET_NAME=lvtn

# ==============================================
# Service URLs (for inter-service communication)
# ==============================================
SERVICE_ACADEMIC_URL=academic
ACADEMIC_PORT=50051

SERVICE_COUNCIL_URL=council
COUNCIL_PORT=50052

SERVICE_FILE_URL=file
FILE_PORT=50053

SERVICE_ROLE_URL=role
ROLE_PORT=50054

SERVICE_THESIS_URL=thesis
THESIS_PORT=50055

SERVICE_USER_URL=user
USER_PORT=50056

# ==============================================
# JWT Configuration
# ==============================================
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15
JWT_REFRESH_EXPIRY=7

# ==============================================
# Google OAuth Configuration
# ==============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_SECRET=your_google_secret
GOOGLE_REDIRECTURL=http://localhost:8080/api/v1/auth/google/callback

# ==============================================
# Application Configuration
# ==============================================
GIN_MODE=release
PORT=8080
